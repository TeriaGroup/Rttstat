<Window x:Class="Netpulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Netpulse.App.Controls"
        xmlns:vm="clr-namespace:Netpulse.App.ViewModels"
        xmlns:loc="clr-namespace:Netpulse.App.Loc"
        Title="Rttstat"
        MinWidth="960" MinHeight="640"
        Width="1120" Height="740"
        Background="#1B1D21"
        Foreground="#F2F3F5"
        Closing="OnClosing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#15171A" Padding="16,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding SpeedText}" VerticalAlignment="Center" Foreground="#9AA0A6" Margin="0,0,12,0"/>
          <Button Content="{loc:L Key=pause}" Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=speedtest}" Command="{Binding RunSpeedCommand}" Margin="0,0,8,0"/>
          <Button Content="{Binding ModeButtonText}" Command="{Binding ToggleSettingsCommand}"/>
        </StackPanel>
        <StackPanel>
          <WrapPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Rttstat" VerticalAlignment="Center" Margin="0,0,12,6"/>
            <Border Style="{StaticResource Card}" Padding="8,4" Margin="0,0,6,6" MinWidth="78">
              <StackPanel>
                <TextBlock Text="{loc:L Key=ping}" FontSize="11" Foreground="#9AA0A6"/>
                <TextBlock Text="{Binding PingText}" FontSize="16" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="8,4" Margin="0,0,6,6" MinWidth="78">
              <StackPanel>
                <TextBlock Text="{loc:L Key=loss}" FontSize="11" Foreground="#9AA0A6"/>
                <TextBlock Text="{Binding LossText}" FontSize="16" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="8,4" Margin="0,0,6,6" MinWidth="92">
              <StackPanel>
                <TextBlock Text="{loc:L Key=dn}" FontSize="11" Foreground="#9AA0A6"/>
                <TextBlock Text="{Binding DownText}" FontSize="16" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="8,4" Margin="0,0,6,6" MinWidth="92">
              <StackPanel>
                <TextBlock Text="{loc:L Key=up}" FontSize="11" Foreground="#9AA0A6"/>
                <TextBlock Text="{Binding UpText}" FontSize="16" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </WrapPanel>
          <TextBlock Margin="0,2,0,0">
            <Run Text="{Binding QualityText}" FontWeight="SemiBold"/>
            <Run Text="  "/>
            <Run Text="{Binding OnlineText}" Foreground="#9AA0A6"/>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="16">
      <DockPanel Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Monitor}}">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBox x:Name="QuickHostBox" Width="200" Text="{Binding QuickHost, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnQuickHostKey" Margin="0,0,8,6"/>
          <Button Content="{loc:L Key=add.target}" Command="{Binding QuickAddCommand}" Margin="0,0,8,6"/>
          <Button Content="1.1.1.1" Command="{Binding AddPresetCommand}" CommandParameter="1.1.1.1" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="1.1.1.1 v6" Command="{Binding AddPresetCommand}" CommandParameter="2606:4700:4700::1111" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="8.8.8.8" Command="{Binding AddPresetCommand}" CommandParameter="8.8.8.8" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="9.9.9.9" Command="{Binding AddPresetCommand}" CommandParameter="9.9.9.9" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="ya.ru" Command="{Binding AddPresetCommand}" CommandParameter="ya.ru" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="google.com" Command="{Binding AddPresetCommand}" CommandParameter="google.com" Margin="0,0,6,6" Padding="8,4"/>
          <ComboBox Width="140" ItemsSource="{Binding BucketOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Period}" Margin="8,0,8,6"/>
          <Button Content="{loc:L Key=route.copy}" Command="{Binding CopyReportCommand}" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding DiagnosisText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PingSeries}" Margin="0,0,0,6">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                <Border Width="12" Height="4" Background="{Binding Stroke}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <UniformGrid DockPanel.Dock="Top" Columns="2" Height="200" Margin="0,0,0,8">
          <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:L Key=chart.ping}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
              <ctrl:SeriesChart Series="{Binding PingSeries}" WindowSeconds="{Binding ChartWindowSeconds}" UnitSuffix="{Binding PingUnit}"/>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="8" Margin="6,0,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:L Key=chart.loss}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
              <ctrl:SeriesChart Series="{Binding LossSeries}" WindowSeconds="{Binding ChartWindowSeconds}" UnitSuffix=" %"/>
            </DockPanel>
          </Border>
        </UniformGrid>
        <DataGrid DockPanel.Dock="Top" Height="168" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="28" EnableRowVirtualization="False" Margin="0,0,0,8">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="28">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" HorizontalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="36">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="×" Padding="4,0" Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:L Key=col.name}" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="{loc:L Key=col.rtt}" Binding="{Binding Rtt}" MinWidth="90" Width="100"/>
            <DataGridTextColumn Header="{loc:L Key=col.avg}" Binding="{Binding AvgText}" MinWidth="110" Width="120"/>
            <DataGridTextColumn Header="{loc:L Key=col.min}" Binding="{Binding MinText}" MinWidth="110" Width="120"/>
            <DataGridTextColumn Header="{loc:L Key=col.max}" Binding="{Binding MaxText}" MinWidth="120" Width="130"/>
            <DataGridTextColumn Header="{loc:L Key=col.jitter}" Binding="{Binding JitterText}" MinWidth="110" Width="120"/>
            <DataGridTextColumn Header="{loc:L Key=col.loss5}" Binding="{Binding Loss}" MinWidth="140" Width="150"/>
            <DataGridTextColumn Header="{loc:L Key=col.sent}" Binding="{Binding SentText}" MinWidth="110" Width="120"/>
            <DataGridTextColumn Header="{loc:L Key=col.recv}" Binding="{Binding RecvText}" MinWidth="100" Width="110"/>
            <DataGridTemplateColumn Header="{loc:L Key=col.graph}" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ctrl:Sparkline Height="22" Width="90" Values="{Binding Spark}" Stroke="{Binding Swatch}" ShowGrid="False" WindowSeconds="120"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,8,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="{loc:L Key=hop.restore}" Command="{Binding ShowHiddenHopsCommand}"
                      ToolTip="{loc:L Key=hop.restore.tip}"
                      Visibility="{Binding HasHiddenHops, Converter={x:Static vm:BoolToVis.Yes}}"/>
              <TextBlock Text="{Binding SelectedTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding RouteHops}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="×" Padding="4,0" ToolTip="{loc:L Key=hop.hide.tip}" Command="{Binding DataContext.HideHopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{loc:L Key=col.hop}" Binding="{Binding Hop}" Width="50"/>
              <DataGridTextColumn Header="{loc:L Key=col.ip}" Binding="{Binding Ip}" Width="*"/>
              <DataGridTextColumn Header="{loc:L Key=col.loss.pct}" Binding="{Binding LossPercent, StringFormat=N1}" MinWidth="90" Width="100"/>
              <DataGridTextColumn Header="{loc:L Key=col.last}" Binding="{Binding LastRttMs, StringFormat=N0}" MinWidth="120" Width="130"/>
              <DataGridTextColumn Header="{loc:L Key=col.avg}" Binding="{Binding AvgRtt, StringFormat=N0}" MinWidth="110" Width="120"/>
              <DataGridTextColumn Header="{loc:L Key=col.best}" Binding="{Binding MinRtt, StringFormat=N0}" MinWidth="100" Width="110"/>
              <DataGridTextColumn Header="{loc:L Key=col.worst}" Binding="{Binding MaxRtt, StringFormat=N0}" MinWidth="100" Width="110"/>
              <DataGridTextColumn Header="{loc:L Key=col.note}" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          </DockPanel>
          <DataGrid Grid.Column="1" ItemsSource="{Binding PeriodOutages}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:L Key=col.start}" Binding="{Binding Start}" Width="*"/>
              <DataGridTextColumn Header="{loc:L Key=col.dur}" Binding="{Binding Duration}" Width="120"/>
              <DataGridTextColumn Header="{loc:L Key=col.cause}" Binding="{Binding Cause}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </DockPanel>

      <Grid Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Settings}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,12,0">
          <TextBlock DockPanel.Dock="Top" Text="{loc:L Key=set.profiles}" FontSize="16" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox Width="160" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}"/>
            <Button Content="{loc:L Key=activate}" Command="{Binding ActivateProfileCommand}" Margin="8,0,0,0"/>
            <Button Content="{loc:L Key=save}" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0"/>
            <Button Content="{loc:L Key=duplicate}" Command="{Binding DuplicateProfileCommand}" Margin="8,0,0,0"/>
            <Button Content="{loc:L Key=delete}" Command="{Binding DeleteProfileCommand}" Margin="8,0,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox Width="120" Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
            <TextBox Width="160" Text="{Binding NewTargetHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
            <Button Content="{loc:L Key=add.target}" Command="{Binding AddTargetCommand}" Margin="0,0,8,0"/>
            <Button Content="{loc:L Key=detect.gw}" Command="{Binding DetectGatewayCommand}"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding SelectedProfile.Targets}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="{loc:L Key=col.on}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
              <DataGridTextColumn Header="{loc:L Key=col.name}" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              <DataGridTextColumn Header="{loc:L Key=col.host}" Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              <DataGridTextColumn Header="{loc:L Key=col.role}" Binding="{Binding Role}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <ScrollViewer Grid.Column="1">
          <StackPanel>
            <TextBlock Text="{loc:L Key=set.general}" FontSize="16" Margin="0,0,0,8"/>
            <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{Binding Ui.Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,0,8"/>
            <TextBlock Text="{loc:L Key=set.adapter}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
            <CheckBox Content="{loc:L Key=set.autostart}" IsChecked="{Binding StartWithWindowsTray}" Margin="0,0,0,4"/>
            <CheckBox Content="{loc:L Key=set.hud}" IsChecked="{Binding Settings.Tray.HudEnabled}" Margin="0,0,0,4"/>
            <CheckBox Content="{loc:L Key=set.mute}" IsChecked="{Binding Settings.Notifications.MuteAll}" Margin="0,0,0,4"/>
            <CheckBox Content="{loc:L Key=set.sound}" IsChecked="{Binding Settings.AlertSound}" Margin="0,0,0,4"/>
            <CheckBox Content="{loc:L Key=set.ipv6}" IsChecked="{Binding PreferIpv6}" Margin="0,0,0,4"/>
            <CheckBox Content="{loc:L Key=set.toast.outage}" IsChecked="{Binding Settings.Notifications.OnOutageStart}" Margin="0,0,0,4"/>
            <CheckBox Content="{loc:L Key=set.toast.th}" IsChecked="{Binding Settings.Notifications.OnPingThreshold}" Margin="0,0,0,8"/>
            <TextBlock Text="{loc:L Key=speed.title}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.LibreSpeed.ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="{loc:L Key=set.save}" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0"/>
              <Button Content="{loc:L Key=set.folder}" Command="{Binding OpenDataFolderCommand}"/>
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Foreground="#9AA0A6" TextWrapping="Wrap" Text="{loc:L Key=set.about}"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
