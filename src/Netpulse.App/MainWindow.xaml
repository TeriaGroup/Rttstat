<Window x:Class="Netpulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Netpulse.App.Controls"
        xmlns:vm="clr-namespace:Netpulse.App.ViewModels"
        xmlns:loc="clr-namespace:Netpulse.App.Loc"
        Title="Rttstat"
        MinWidth="900" MinHeight="600"
        Width="1100" Height="720"
        Background="#1B1D21"
        Foreground="#F2F3F5"
        Closing="OnClosing">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ReloadLogCommand}"/>
  </Window.InputBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#24262B" Padding="16,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ComboBox Width="110" ItemsSource="{Binding Ui.Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=pause}" Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=speedtest}" Command="{Binding RunSpeedCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="Rttstat"/>
          <TextBlock Foreground="#9AA0A6" Text="{Binding StatusText}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Left" Width="180" Background="#15171A" Padding="8">
      <StackPanel>
        <Button Content="{loc:L Key=nav.dash}" Command="{Binding GoCommand}" CommandParameter="Dashboard" Margin="0,0,0,6"/>
        <Button Content="{loc:L Key=nav.targets}" Command="{Binding GoCommand}" CommandParameter="Targets" Margin="0,0,0,6"/>
        <Button Content="{loc:L Key=nav.log}" Command="{Binding GoCommand}" CommandParameter="Log" Margin="0,0,0,6"/>
        <Button Content="{loc:L Key=nav.stats}" Command="{Binding GoCommand}" CommandParameter="Statistics" Margin="0,0,0,6"/>
        <Button Content="{loc:L Key=nav.speed}" Command="{Binding GoCommand}" CommandParameter="Speed" Margin="0,0,0,6"/>
        <Button Content="{loc:L Key=nav.settings}" Command="{Binding GoCommand}" CommandParameter="Settings"/>
      </StackPanel>
    </Border>
    <Grid Margin="16">
      <ScrollViewer Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Dash}}">
        <StackPanel>
          <TextBlock Text="{Binding Banner}" Foreground="#F5C542" Margin="0,0,0,8"/>
          <UniformGrid Columns="5" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
              <TextBlock Text="{loc:L Key=ping}" Foreground="#B8BDC4"/><TextBlock FontSize="20" Text="{Binding PingText}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
              <TextBlock Text="{loc:L Key=loss}" Foreground="#B8BDC4"/><TextBlock FontSize="20" Text="{Binding LossText}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
              <TextBlock Text="{loc:L Key=dn}" Foreground="#B8BDC4"/><TextBlock FontSize="20" Text="{Binding DownText}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
              <TextBlock Text="{loc:L Key=up}" Foreground="#B8BDC4"/><TextBlock FontSize="20" Text="{Binding UpText}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{loc:L Key=outage}" Foreground="#B8BDC4"/>
              <TextBlock FontSize="16" Text="{Binding QualityText}"/>
              <TextBlock FontSize="12" Foreground="#B8BDC4" Text="{Binding OnlineText}"/>
            </StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="{loc:L Key=ping}" Margin="0,0,0,4"/>
          <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
            <ctrl:Sparkline Height="130" Values="{Binding PingSpark}" Stroke="#3DDC97" UnitSuffix=" ms" WindowSeconds="120"/>
          </Border>
          <TextBlock Text="{loc:L Key=loss}" Margin="0,4,0,4"/>
          <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
            <ctrl:Sparkline Height="110" Values="{Binding LossSpark}" Stroke="#F07178" UnitSuffix=" %" FloorZero="True" WindowSeconds="120"/>
          </Border>
          <TextBlock Text="{loc:L Key=dn}" Margin="0,4,0,4"/>
          <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
            <ctrl:Sparkline Height="110" Values="{Binding DownSpark}" Stroke="#7EC8E3" UnitSuffix=" Mbps" FloorZero="True" WindowSeconds="120"/>
          </Border>
          <TextBlock Text="{loc:L Key=up}" Margin="0,4,0,4"/>
          <Border Style="{StaticResource Card}" Padding="8">
            <ctrl:Sparkline Height="110" Values="{Binding UpSpark}" Stroke="#F5C542" UnitSuffix=" Mbps" FloorZero="True" WindowSeconds="120"/>
          </Border>
          <TextBlock Text="{Binding AdapterLabel}" Foreground="#9AA0A6" Margin="0,8,0,8"/>
          <DataGrid ItemsSource="{Binding Targets}" AutoGenerateColumns="False" IsReadOnly="True" Height="180">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:L Key=col.name}" Binding="{Binding DisplayName}" Width="*"/>
              <DataGridTextColumn Header="{loc:L Key=col.host}" Binding="{Binding Host}" Width="*"/>
              <DataGridTextColumn Header="{loc:L Key=col.ip}" Binding="{Binding ResolvedIp}" Width="*"/>
              <DataGridTextColumn Header="{loc:L Key=col.rtt}" Binding="{Binding LastRttMs, StringFormat=N0}" Width="80"/>
              <DataGridTextColumn Header="{loc:L Key=col.status}" Binding="{Binding LastStatus, Converter={StaticResource PingStatus}}" Width="120"/>
              <DataGridTextColumn Header="{loc:L Key=col.loss5}" Binding="{Binding Loss5m, StringFormat=N1}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </ScrollViewer>

      <DockPanel Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Targets}}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <ComboBox Width="220" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}"/>
          <Button Content="{loc:L Key=activate}" Command="{Binding ActivateProfileCommand}" Margin="8,0"/>
          <Button Content="{loc:L Key=save}" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=duplicate}" Command="{Binding DuplicateProfileCommand}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=delete}" Command="{Binding DeleteProfileCommand}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=detect.gw}" Command="{Binding DetectGatewayCommand}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <TextBox Width="160" Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
          <TextBox Width="200" Text="{Binding NewTargetHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=add.target}" Command="{Binding AddTargetCommand}"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding SelectedProfile.Targets}" AutoGenerateColumns="False" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="{loc:L Key=col.on}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
            <DataGridTextColumn Header="{loc:L Key=col.name}" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            <DataGridTextColumn Header="{loc:L Key=col.host}" Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            <DataGridTextColumn Header="{loc:L Key=col.role}" Binding="{Binding Role}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <DockPanel Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Log}}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBox Width="240" Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
          <ComboBox Width="160" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding LogCategory}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=filter}" Command="{Binding ReloadLogCommand}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=export.csv}" Command="{Binding ExportLogCommand}"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding LogRows}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:L Key=col.time}" Binding="{Binding Time}" Width="160"/>
            <DataGridTextColumn Header="{loc:L Key=col.level}" Binding="{Binding Level}" Width="80"/>
            <DataGridTextColumn Header="{loc:L Key=col.cat}" Binding="{Binding Category}" Width="100"/>
            <DataGridTextColumn Header="{loc:L Key=col.msg}" Binding="{Binding Message}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <DockPanel Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Stats}}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <ComboBox Width="140" ItemsSource="{Binding BucketOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding StatsBucket}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=refresh}" Command="{Binding RefreshStatsCommand}" Margin="0,0,8,0"/>
          <Button Content="{loc:L Key=export}" Command="{Binding ExportStatsCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding StatsSummary}" FontSize="16" LineHeight="26"/>
          <Border Style="{StaticResource Card}" Padding="8" Margin="0,16,0,0">
            <ctrl:Sparkline Height="140" Values="{Binding StatsSpark}" Stroke="#3DDC97"/>
          </Border>
        </StackPanel>
      </DockPanel>

      <DockPanel Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Speed}}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="{loc:L Key=speed.title}" FontSize="16" Margin="0,0,0,8"/>
          <TextBox Text="{Binding Settings.LibreSpeed.ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="{loc:L Key=run.test}" Command="{Binding RunSpeedCommand}" Margin="0,0,8,0"/>
            <Button Content="{loc:L Key=cancel}" Command="{Binding CancelSpeedCommand}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding SpeedText}"/>
          </StackPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Speedtests}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:L Key=col.when}" Binding="{Binding StartedAtUtc}" Width="180"/>
            <DataGridTextColumn Header="{loc:L Key=col.down}" Binding="{Binding DownloadMbps, StringFormat=N2}" Width="80"/>
            <DataGridTextColumn Header="{loc:L Key=col.up}" Binding="{Binding UploadMbps, StringFormat=N2}" Width="80"/>
            <DataGridTextColumn Header="{loc:L Key=col.rtt}" Binding="{Binding PingMs, StringFormat=N0}" Width="70"/>
            <DataGridTextColumn Header="{loc:L Key=col.server}" Binding="{Binding ServerUrl}" Width="*"/>
            <DataGridTextColumn Header="{loc:L Key=col.error}" Binding="{Binding Error}" Width="160"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <ScrollViewer Visibility="{Binding Section, Converter={x:Static vm:SectionToVis.Settings}}">
        <StackPanel>
          <TextBlock Text="{loc:L Key=set.general}" FontSize="16" Margin="0,0,0,8"/>
          <TextBlock Text="{loc:L Key=set.lang}" Margin="0,0,0,4"/>
          <ComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{Binding Ui.Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,0,8"/>
          <CheckBox Content="{loc:L Key=set.autostart}" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,0,0,6"/>
          <CheckBox Content="{loc:L Key=set.open}" IsChecked="{Binding Settings.OpenWindowOnStart}" Margin="0,0,0,6"/>
          <CheckBox Content="{loc:L Key=set.mute}" IsChecked="{Binding Settings.Notifications.MuteAll}" Margin="0,0,0,6"/>
          <CheckBox Content="{loc:L Key=set.toast.outage}" IsChecked="{Binding Settings.Notifications.OnOutageStart}" Margin="0,0,0,6"/>
          <CheckBox Content="{loc:L Key=set.toast.th}" IsChecked="{Binding Settings.Notifications.OnPingThreshold}" Margin="0,0,0,6"/>
          <CheckBox Content="{loc:L Key=set.toast.speed}" IsChecked="{Binding Settings.Notifications.OnSpeedtestComplete}" Margin="0,0,0,6"/>
          <CheckBox Content="{loc:L Key=set.quiet}" IsChecked="{Binding Settings.Notifications.QuietHoursEnabled}" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="80" Text="{Binding Settings.Notifications.QuietHoursFrom}"/>
            <TextBlock Text="{loc:L Key=set.to}" VerticalAlignment="Center" Margin="8,0"/>
            <TextBox Width="80" Text="{Binding Settings.Notifications.QuietHoursTo}"/>
          </StackPanel>
          <TextBlock Text="{loc:L Key=set.adapter}" Margin="0,8,0,4"/>
          <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Label"/>
          <TextBlock Text="{loc:L Key=set.tray}" FontSize="16" Margin="0,16,0,8"/>
          <CheckBox Content="{loc:L Key=set.hud}" IsChecked="{Binding Settings.Tray.HudEnabled}" Margin="0,0,0,4"/>
          <CheckBox Content="{loc:L Key=set.strip}" IsChecked="{Binding Settings.Tray.StripEnabled}" Margin="0,0,0,4"/>
          <CheckBox Content="{loc:L Key=set.flyout}" IsChecked="{Binding Settings.Tray.FlyoutEnabled}" Margin="0,0,0,4"/>
          <CheckBox Content="{loc:L Key=set.hidefs}" IsChecked="{Binding Settings.Tray.HideHudInFullscreen}" Margin="0,0,0,4"/>
          <ComboBox ItemsSource="{Binding StripMetrics}" SelectedItem="{Binding Settings.Tray.StripMetric}" Width="160" HorizontalAlignment="Left" Margin="0,4,0,8"/>
          <TextBlock Text="{loc:L Key=set.schedule}" Margin="0,8,0,4"/>
          <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Schedules}" SelectedItem="{Binding Settings.LibreSpeed.Schedule}"/>
          <CheckBox Content="{loc:L Key=set.metered}" IsChecked="{Binding Settings.LibreSpeed.AllowMetered}" Margin="0,8,0,8"/>
          <TextBlock Text="{loc:L Key=set.ret}" Margin="0,8,0,4"/>
          <StackPanel Orientation="Horizontal">
            <TextBox Width="50" Text="{Binding Settings.Retention.RawSamplesDays}" Margin="0,0,6,0"/>
            <TextBox Width="50" Text="{Binding Settings.Retention.MinuteSamplesDays}" Margin="0,0,6,0"/>
            <TextBox Width="50" Text="{Binding Settings.Retention.HourlySamplesDays}" Margin="0,0,6,0"/>
            <TextBox Width="50" Text="{Binding Settings.Retention.DailySamplesDays}" Margin="0,0,6,0"/>
            <TextBox Width="50" Text="{Binding Settings.Retention.EventsDays}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{loc:L Key=set.save}" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0"/>
            <Button Content="{loc:L Key=set.folder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0"/>
            <Button Content="{loc:L Key=set.vacuum}" Command="{Binding VacuumCommand}" Margin="0,0,8,0"/>
            <Button Content="{loc:L Key=set.reset}" Command="{Binding ResetSettingsCommand}"/>
          </StackPanel>
          <TextBlock Margin="0,16,0,0" Foreground="#B8BDC4" TextWrapping="Wrap"
                     Text="{loc:L Key=set.about}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
